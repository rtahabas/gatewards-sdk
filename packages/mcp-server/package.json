{
  "name": "@gatewards/mcp-server",
  "version": "0.2.0-beta.1",
  "description": "MCP server for Gatewards — give any agent governed, non-custodial access to paid APIs (per-agent spend caps, cross-agent dedup, x402 settlement).",
  "license": "Apache-2.0",
  "author": "Gatewards",
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "gatewards-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rtahabas/gatewards-sdk.git",

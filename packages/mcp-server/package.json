    "non-custodial",
    "x402",
    "usdc",
    "gatewards"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@gatewards/agent-sdk": "^0.2.0-beta.1",
    "axios": "^1.8.0"
